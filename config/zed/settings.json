// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "relative_line_numbers": "disabled",
  "gutter": {
    "line_numbers": true
  },
  "text_rendering_mode": "platform_default",
  "buffer_line_height": "standard",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "font_size": 12.0,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "minimap": {
    "show": "always",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": ["Droid Sans Mono", "monospace", "monospace"],
  "buffer_font_family": "Berkeley Mono",
  "file_types": {
    "c": ["*.h"],
  },
  "tab_size": 2,
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "VSCode Dark Modern",
  },
  "jupyter": {
    "enabled": false,
  },
}
